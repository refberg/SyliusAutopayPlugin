{
    // Mutation testing covers the security-relevant logic that has unit tests:
    // API client, command handlers, hashes, ITN parsing, transaction validation and payment state rules.
    "source": {
        "directories": [
            "src/Api",
            "src/CommandHandler",
            "src/Config",
            "src/Notification",
            "src/Order",
            "src/Payment",
            "src/Signature"
        ],
        "excludes": [
            "Payment/PaymentLocker.php"
        ]
    },
    // Log calls are diagnostics, not behaviour: mutating their context is not worth a test.
    // The regex matches single lines, so mutants on the context lines of a multi-line log call survive; they are log context.
    "mutators": {
        "@default": true,
        "global-ignoreSourceCodeByRegex": [
            "\\$this->logger->.*"
        ]
    },
    "phpUnit": {
        "customPath": "vendor/bin/phpunit"
    },
    "testFrameworkOptions": "--testsuite=unit",
    "logs": {
        "text": "var/infection.log",
        "github": true
    },
    // Measured MSI is 89.4% (covered code: 89.4%); the thresholds keep it from dropping.
    "minMsi": 87,
    "minCoveredMsi": 87
}
